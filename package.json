{
  "name": "lawyer-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev:worker",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm --prefix frontend run build && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'dist', {recursive: true});\"",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm run dev:worker"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
